# ---------- ضروری ----------
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/atalar

# ---------- فقط برای نصب جدید (دیتابیس خالی) ----------
# حساب مدیر اولیه؛ اگر تنظیم نشود حساب نمایشی admin@atalar.ir / admin123 ساخته می‌شود
ADMIN_NAME=مدیر هتل
ADMIN_EMAIL=you@yourhotel.ir
ADMIN_PASSWORD=ChangeMe-2025
# نوع داده‌های اولیه برای نصب جدید:
#   (خالی) یا espinas = هتل اسپیناس پالاس تهران (پیش‌فرض)
#   atalar           = ریزورت ۴ ستاره با استخر (آتالار)
#   city             = هتل شهری ۳ ستاره با کافه و رستوران، بدون استخر
HOTEL_PRESET=
HOTEL_NAME=هتل اسپیناس پالاس
# false = رزرو، پیام، نظر و سند مالی نمونه ساخته نشود (اتاق‌ها و خدمات نمونه برای شروع ساخته می‌شوند)
SEED_DEMO=false

# ---------- اختیاری ----------
# false = حالت نمایشی همیشه خاموش (بدون توجه به تنظیم پنل)
DEMO_MODE=false
# تعداد اتصال‌های دیتابیس هر پروسه
PG_POOL_MAX=5
# true/false: اجبار کوکی Secure؛ خالی = تشخیص خودکار از x-forwarded-proto
COOKIE_SECURE=
# true = اجرای خودکار مایگریشن‌ها هنگام شروع سرور غیرفعال شود (توصیه نمی‌شود)
SKIP_DB_MIGRATIONS=

# کلید امضای کوکی پرتال مهمانان (اختیاری؛ خالی = خودکار ساخته و در دیتابیس ذخیره می‌شود)
APP_SECRET=
# true = غیرفعال کردن کارهای زمان‌بندی‌شده (کمپین‌ها، پیامک تولد، دعوت به ثبت نظر)
DISABLE_JOBS=
