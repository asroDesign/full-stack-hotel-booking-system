# ---------- Database ----------
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app_db
PG_POOL_MAX=5

# ---------- Runtime mode ----------
# false  => production mode: no demo data is ever seeded. Recommended for live.
# true   => demo mode: seed demo content ONLY into an empty database.
DEMO_MODE=false
# Only for demo environments; keep unset in production to hide demo credentials.
# NEXT_PUBLIC_DEMO_CREDENTIALS=true

# ---------- Admin bootstrap (used only when no admin account exists) ----------
ADMIN_NAME=مدیر هتل
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe-Str0ng-Pass

# ---------- Session ----------
# Set to true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=true

# ---------- Public URL (RSS / links) ----------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------- SMS (Kavenegar or sms.ir, pattern based) ----------
SMS_PROVIDER=kavenegar
ADMIN_SMS_PHONE=09xxxxxxxxx
KAVENEGAR_API_KEY=
KAVENEGAR_PATTERN_ADMIN_BOOKING=
KAVENEGAR_PATTERN_GUEST_RESERVATION=
KAVENEGAR_PATTERN_GUEST_STATUS=
# SMSIR_API_KEY=
# SMSIR_TEMPLATE_ADMIN_BOOKING=
# SMSIR_TEMPLATE_GUEST_RESERVATION=
# SMSIR_TEMPLATE_GUEST_STATUS=
